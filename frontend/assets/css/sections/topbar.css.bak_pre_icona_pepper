/* =====================================================================
   topbar.css — sezione MAIN: colonna a destra della sidebar.

   Contiene:
     - .main / .workarea / .content (i contenitori di layout)
     - .topbar, .breadcrumb-bar, .user-badge (header in alto)
     - .tab-strip (striscia di tab stile IDE, alternativa al breadcrumb)

   Fa parte dello split di app.css — vedi assets/css/app.css per l'indice
   completo.
   ===================================================================== */

.main {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  min-width: 0;
  /*indispensabile: senza, i figli larghi sfondano il flex invece di scrollare;*/
}

.topbar {
  height: var(--topbar-h);
  flex: 0 0 var(--topbar-h);
  display: flex;
  align-items: center;
  gap: .625rem;
  padding: 0 .875rem;
  background: #fff;
  border-bottom: 1px solid var(--bs-border-color);
}

.topbar-spacer {
  flex: 1 1 auto;
}

.breadcrumb-bar {
  font-size: .875rem;
  color: var(--bs-secondary-color);
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.breadcrumb-bar strong {
  color: var(--bs-body-color);
  font-weight: 600;
}

/* Badge utente, statico: non e' collegato a nulla, serve solo a far
   somigliare la topbar a quella di un gestionale vero (dove l'utente
   che sta lavorando e' sempre visibile). Prende il posto che prima
   aveva l'indicatore di sincronizzazione, spostato nel footer della
   sidebar (vedi .sync-status in sidebar.css).

   Il caret ha un trattamento leggermente diverso dal resto (colore piu'
   tenue, hover proprio) apposta: comunica "qui si aprirebbe un menu"
   anche se non c'e' nulla dietro, senza dover scrivere una didascalia.
   Stessa idea di un pulsante disabilitato che pero' SEMBRA cliccabile:
   qui invece sembra cliccabile perche', in una versione futura, lo
   sarebbe davvero. */

.user-badge {
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  white-space: nowrap;
  padding: .25rem .5rem .25rem .25rem;
  border-radius: 999px;
  cursor: pointer;
  transition: background .12s;
}

.user-badge:hover {
  background: rgba(0, 0, 0, .045);
}

.user-badge:hover .user-caret {
  color: var(--bs-body-color);
}

.user-avatar {
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  border-radius: 50%;
  background: var(--bs-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .68rem;
  font-weight: 600;
  letter-spacing: .02em;
}

.user-name {
  font-size: .82rem;
  font-weight: 500;
  color: var(--bs-body-color);
}

.user-caret {
  width: .65rem;
  height: .65rem;
  color: var(--bs-secondary-color);
  transition: color .12s;
}

/* Striscia di tab in stile "classico" (browser/IDE), integrata nella
   topbar invece che su una riga propria: stessi 52px di altezza
   (--topbar-h) dell'intera header, non se ne aggiungono altri. Appare
   solo da due tab aperte in su e prende il posto del breadcrumb (si
   alternano, vedi tabs.js render()).

   perche' non una pillola piena: su un gestionale una pillola colorata
   assomiglia a un badge di stato (vedi .badge-soft in views-common.css),
   non a un selettore di scheda — confonderebbe i due linguaggi visivi.

   Forma "a scatola" in stile IDE (angoli squadrati, bordo completo)
   invece che pillola arrotondata: coerente con l'ispirazione MDI/VCL
   dichiarata in core/tabs.js. La tab attiva ha lo stesso sfondo di
   .content (--content-bg), un margine negativo che copre esattamente
   il bordo inferiore della topbar in quel punto (si "salda" al
   contenuto sotto) e un accento di 2px in alto nel colore primario. Le
   inattive restano piatte — bordo superiore trasparente della stessa
   larghezza, cosi' passare da inattiva ad attiva non fa "saltare" il
   layout — senza divisori verticali fra loro: percettibili ma non
   appariscenti. */

.tab-strip {
  display: flex;
  align-items: flex-end;
  align-self: stretch;
  gap: .2rem;
  margin: 0;
  padding: 0;
  list-style: none;
  flex: 1 1 auto;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: none;
}

.tab-strip::-webkit-scrollbar {
  display: none;
}

.tab-strip li {
  flex: 0 0 auto;
}

.tab-strip .nav-link {
  display: flex;
  align-items: center;
  gap: .4rem;
  height: 2.15rem;
  padding: 0 .35rem 0 .75rem;
  margin-bottom: -1px;
  border: 1px solid transparent;
  border-top: 2px solid transparent;
  border-bottom: none;
  border-radius: 0;
  font-size: .8rem;
  color: var(--bs-secondary-color);
  white-space: nowrap;
  background: transparent;
}

.tab-strip .nav-link:hover {
  background: rgba(0, 0, 0, .035);
  color: var(--bs-body-color);
}

.tab-strip .nav-link.active {
  background: var(--content-bg);
  border-color: var(--bs-border-color);
  border-top-color: var(--bs-primary);
  border-bottom: none;
  color: var(--bs-body-color);
  font-weight: 500;
}

.tab-strip .btn-close {
  opacity: .4;
}

.tab-strip .nav-link:hover .btn-close,
.tab-strip .nav-link.active .btn-close {
  opacity: .65;
}

.workarea {
  flex: 1 1 auto;
  display: flex;
  min-height: 0;
  /* "Canvas" dietro al pannello chat: si vede solo nel margine intorno
     alla card (vedi .chat-panel in chat.css), il content lo copre
     comunque con il proprio sfondo. Via di mezzo fra il layout denso di
     prima e un redesign completo "tutto arrotondato": qui resta
     invariato, solo la chat diventa una card fluttuante — il content
     resta pieno per non perdere densita' sulle tabelle. */
  background: var(--content-bg);
}

.content {
  flex: 1 1 auto;
  min-width: 0;
  overflow-y: auto;
  padding: 1.25rem;
  background: var(--content-bg);
}
