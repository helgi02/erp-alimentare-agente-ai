<?xml version="1.0" encoding="UTF-8"?>
<!--
     web.config — regola IIS per le route pulite del frontend.

     PERCHE' SERVE
     Il router (assets/js/core/router.js) e' passato da URL con hash
     (#/vendite, mai spediti al server) a percorsi puliti (/vendite,
     spediti DAVVERO al server a ogni ricarica o link incollato). IIS
     pero' serve solo file statici: senza questa regola, aprire
     http://localhost:83/vendite direttamente (F5, link condiviso,
     link generato dall'agente in chat) risponde 404, perche' sul
     disco non esiste nessun file "vendite".

     COSA FA LA REGOLA
     Per qualunque richiesta che NON corrisponde a un file o una
     cartella reali sotto questa root (quindi non index.html,
     assets/..., ecc.), riscrive la risposta su /index.html. A quel
     punto e' di nuovo il router JS lato client a leggere
     location.pathname e disegnare la vista giusta - lo stesso ruolo
     che prima svolgeva index.html "di default" per qualunque hash.

     REQUISITO: modulo URL Rewrite per IIS
     Non incluso in un'installazione IIS standard. Da scaricare e
     installare da Microsoft (IIS URL Rewrite Module 2.1) se il sito
     non risponde e i log di IIS segnalano che l'elemento
     <rewrite> non e' riconosciuto.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA fallback a index.html" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Richieste a un file reale (assets/js/..., assets/css/..., index.html
                 stesso) passano invariate: solo cio' che non esiste su disco
                 viene deviato su index.html. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- .svg non e' sempre registrato con il MIME type corretto su IIS
         "di fabbrica": senza questo, assets/img/logo.svg puo' essere
         servito come application/octet-stream (o rifiutato) invece di
         image/svg+xml, e il browser non lo mostra. -->
    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />

      <!-- DisableCache: senza Cache-Control/Expires nella risposta, Chrome
           applica una euristica basata su Last-Modified e puo' riusare per
           GIORNI una copia di assets/js/*.js gia' in cache anche dopo che
           il file sul disco e' cambiato (visto proprio durante lo sviluppo
           di view-materie-prime.js: un browser con gia' una copia vecchia
           di view-da-costruire.js in cache continuava a mostrare "In
           costruzione" anche a file corretto e con reload normale, perche'
           il browser non richiedeva nemmeno una revalidazione al server).
           In un sito in produzione useremmo piuttosto nomi di file con
           hash (cache busting) invece di disabilitare la cache; qui, senza
           uno step di build, e' la soluzione piu' semplice per uno sviluppo
           locale sereno. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
